> ### Name: prepare_detection_data_for_wade
> ### Title: Prepare real fish detection data for WADE positioning
> ### Aliases: prepare_detection_data_for_wade
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # Prepare data for a specific fish with daily aggregation
> ##D wade_data <- prepare_detection_data_for_wade(
> ##D   fish_detections = stoney_fish_detections,
> ##D   station_deployments = stoney_rx_deploy,
> ##D   selected_fish_id = "Walleye-1512985",
> ##D   time_aggregation = "day"
> ##D )
> ##D 
> ##D # Check for deployment warnings
> ##D if (length(wade_data$deployment_warnings) > 0) {
> ##D   cat("Deployment warnings:\n")
> ##D   cat(paste(wade_data$deployment_warnings, collapse = "\n"))
> ##D }
> ##D 
> ##D # Use with WADE positioning
> ##D results <- calculate_fish_positions(
> ##D   station_detections = wade_data$station_detections,
> ##D   station_distances_df = station_distances,
> ##D   station_info = wade_data$station_info,
> ##D   # ... other parameters
> ##D )
> ##D 
> ##D # Hourly aggregation for fine-scale analysis
> ##D wade_data_hourly <- prepare_detection_data_for_wade(
> ##D   fish_detections = stoney_fish_detections,
> ##D   station_deployments = stoney_rx_deploy,
> ##D   selected_fish_id = "Walleye-1512985",
> ##D   time_aggregation = "hour",
> ##D   start_time = as.POSIXct("2023-10-15 00:00:00", tz = "UTC"),
> ##D   end_time = as.POSIXct("2023-10-17 00:00:00", tz = "UTC")
> ##D )
> ## End(Not run)
> 
> 
> 
> 
