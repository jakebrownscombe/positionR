> ##D # POSIX datetime aggregation by day
> ##D results <- calculate_fish_positions(
> ##D   station_detections = fish_tracks$detections,
> ##D   station_distances_df = distances,
> ##D   receiver_stations = stations,
> ##D   time_col = "datetime",
> ##D   time_aggregation = "day"
> ##D )
> ##D 
> ##D # POSIX datetime aggregation by hour
> ##D results <- calculate_fish_positions(
> ##D   station_detections = fish_tracks$detections,
> ##D   station_distances_df = distances,
> ##D   receiver_stations = stations,
> ##D   time_col = "datetime",
> ##D   time_aggregation = "hour"
> ##D )
> ## End(Not run)
> 
