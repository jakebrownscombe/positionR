> nameEx("sample_points_from_track_grid")
> ### * sample_points_from_track_grid
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: sample_points_from_track_grid
> ### Title: Sample points from track data grid cell usage
> ### Aliases: sample_points_from_track_grid
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # Basic usage-weighted sampling
> ##D usage_points <- sample_points_from_track_grid(
> ##D   track_data = fish_simulation$tracks,
> ##D   grid_resolution = 100,
> ##D   n_points = 500,
> ##D   seed = 123
> ##D )
> ##D 
> ##D # Sample from specific fish and time periods
> ##D selected_usage <- sample_points_from_track_grid(
> ##D   track_data = fish_simulation$tracks,
> ##D   grid_resolution = 50,  # Finer resolution
> ##D   n_points = 200,
> ##D   fish_select = c(1, 2, 3),
> ##D   time_select = c("2025-07-15", "2025-07-16"),
> ##D   min_count_threshold = 3  # Only heavily used cells
> ##D )
> ##D 
> ##D # Sample without time grouping
> ##D overall_usage <- sample_points_from_track_grid(
> ##D   track_data = fish_simulation$tracks,
> ##D   by_time_period = FALSE,
> ##D   n_points = 1000
> ##D )
> ##D 
> ##D # Use with reference raster for consistent grid
> ##D raster_usage <- sample_points_from_track_grid(
> ##D   track_data = fish_simulation$tracks,
> ##D   reference_raster = depth_raster,
> ##D   n_points = 300,
> ##D   crs = 32617
> ##D )
> ##D 
> ##D # Plot usage-weighted sampling
> ##D library(ggplot2)
> ##D ggplot() +
> ##D   geom_sf(data = usage_points, aes(color = count, size = count), 
> ##D           alpha = 0.6) +
> ##D   scale_color_viridis_c(name = "Track\nPoints", trans = "sqrt") +
> ##D   scale_size_continuous(name = "Track\nPoints", range = c(0.5, 3), trans = "sqrt") +
> ##D   facet_wrap(~fish_id + time_period_label) +
> ##D   theme_minimal() +
> ##D   labs(title = "Usage-Weighted Spatial Sampling")
> ##D 
> ##D # Compare usage intensity across fish
> ##D usage_summary <- usage_points %>%
> ##D   st_drop_geometry() %>%
> ##D   group_by(fish_id) %>%
> ##D   summarise(
> ##D     mean_usage = mean(count),
> ##D     max_usage = max(count),
> ##D     total_samples = n(),
> ##D     .groups = 'drop'
> ##D   )
> ## End(Not run)
> 
> 
> 
