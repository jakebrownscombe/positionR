> nameEx("calculate_station_distances")
> ### * calculate_station_distances
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: calculate_station_distances
> ### Title: Calculate cost distances from receiver stations to all raster
> ###   cells
> ### Aliases: calculate_station_distances
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # Generate receiver stations with numeric IDs (default)
> ##D stations <- generate_random_points(depth_raster, n_points = 5, seed = 123)
> ##D 
> ##D # Calculate distances with default point_id column
> ##D distances <- calculate_station_distances(depth_raster, stations)
> ##D 
> ##D # Calculate distances with 1000m maximum
> ##D distances_limited <- calculate_station_distances(
> ##D   raster = depth_raster,
> ##D   receiver_frame = stations,
> ##D   max_distance = 1000
> ##D )
> ##D 
> ##D # Use with character station IDs
> ##D # Assuming stoney_rx_deploy has a 'station_id' column with character IDs
> ##D distances_char <- calculate_station_distances(
> ##D   raster = depth_raster,
> ##D   receiver_frame = stoney_rx_deploy,
> ##D   max_distance = 3000,
> ##D   station_col = "station_id"  # Specify the column with station IDs
> ##D )
> ##D 
> ##D # Analyze tortuosity patterns
> ##D library(dplyr)
> ##D tortuosity_summary <- distances %>%
> ##D   group_by(station_no) %>%
> ##D   summarise(
> ##D     mean_tortuosity = mean(tortuosity, na.rm = TRUE),
> ##D     max_cost_dist = max(cost_distance, na.rm = TRUE)
> ##D   )
> ## End(Not run)
> 
> ## Not run: 
> ##D # With numeric station IDs (default)
> ##D stations_numeric <- generate_random_points(depth_raster, n_points = 5, seed = 123)
> ##D distances_numeric <- calculate_station_distances(depth_raster, stations_numeric)
> ##D 
> ##D # With character station IDs
> ##D stations_char <- stoney_rx_deploy  # Has character station_id column
> ##D distances_char <- calculate_station_distances(
> ##D   raster = depth_raster,
> ##D   receiver_frame = stations_char,
> ##D   max_distance = 3000,
> ##D   station_col = "station_id"
> ##D )
> ##D 
> ##D # Verify station ID preservation
> ##D unique(distances_char$station_no)  # Should show character IDs
> ## End(Not run)
> 
> 
> 
> 
