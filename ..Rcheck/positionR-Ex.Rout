> ### Name: sample_points_from_probabilities
> ### Title: Sample points from position probability surfaces
> ### Aliases: sample_points_from_probabilities
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # Calculate fish positions first
> ##D positioning_results <- calculate_fish_positions(station_detections, distances, stations)
> ##D 
> ##D # Sample 100 points per fish-time combination for all data
> ##D sampled_points <- sample_points_from_probabilities(
> ##D   positioning_results,
> ##D   prob_column = "weighted_mean_DE_normalized_scaled",
> ##D   n_points = 100,
> ##D   seed = 123
> ##D )
> ##D 
> ##D # Sample from multiple specific fish and time periods
> ##D multi_samples <- sample_points_from_probabilities(
> ##D   positioning_results,
> ##D   prob_column = "integrated_prob",
> ##D   n_points = 50,
> ##D   fish_select = c(1, 2, 3),
> ##D   time_select = c("2025-07-15", "2025-07-16", "2025-07-17"),
> ##D   by_group = TRUE  # 50 points per fish-time combination
> ##D )
> ##D 
> ##D # Sample 1000 points total distributed across all groups
> ##D distributed_samples <- sample_points_from_probabilities(
> ##D   positioning_results,
> ##D   n_points = 1000,
> ##D   by_group = FALSE  # Distribute 1000 points across all combinations
> ##D )
> ##D 
> ##D # Sample only from low-probability uncertainty regions
> ##D uncertainty_samples <- sample_points_from_probabilities(
> ##D   positioning_results,
> ##D   prob_column = "integrated_prob",
> ##D   n_points = 200,
> ##D   min_prob_threshold = 0.001,
> ##D   max_prob_threshold = 0.05,  # Exclude high-probability areas
> ##D   seed = 456
> ##D )
> ##D 
> ##D # Sample with specific CRS (UTM Zone 18N)
> ##D utm_samples <- sample_points_from_probabilities(
> ##D   positioning_results,
> ##D   n_points = 100,
> ##D   crs = 32618  # EPSG code for UTM Zone 18N
> ##D )
> ##D 
> ##D # Plot sampled points colored by time
> ##D library(ggplot2)
> ##D ggplot() +
> ##D   geom_sf(data = multi_samples, aes(color = time_period_posix)) +
> ##D   scale_color_viridis_c() +
> ##D   facet_wrap(~fish_id) +
> ##D   theme_minimal() +
> ##D   labs(title = "Sampled Position Points by Fish and Time")
> ##D 
> ##D # Temporal centroid analysis
> ##D library(dplyr)
> ##D temporal_centroids <- multi_samples %>%
> ##D   group_by(fish_id, time_period_posix, time_period_label) %>%
> ##D   summarise(
> ##D     n_samples = n(),
> ##D     mean_prob = mean(probability),
> ##D     centroid = sf::st_union(geometry) %>% sf::st_centroid(),
> ##D     .groups = 'drop'
> ##D   ) %>%
> ##D   sf::st_as_sf()
> ##D 
> ##D # Create animated track from sampled points
> ##D track_samples <- multi_samples %>%
> ##D   arrange(fish_id, time_period_posix) %>%
> ##D   group_by(fish_id) %>%
> ##D   summarise(
> ##D     track = sf::st_cast(sf::st_union(geometry), "LINESTRING")
> ##D   )
> ## End(Not run)
> 
> 
> 
> 
