> flush(stderr()); flush(stdout())
> 
> ### Name: sample_points_from_system_de
> ### Title: Sample points from system detection efficiency surfaces
> ### Aliases: sample_points_from_system_de
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # Sample from system detection efficiency
> ##D sampled_points <- sample_points_from_system_de(
> ##D   system_DE,
> ##D   n_points = 500,
> ##D   seed = 123
> ##D )
> ##D 
> ##D # Focus on moderate detection areas
> ##D moderate_samples <- sample_points_from_system_de(
> ##D   system_DE,
> ##D   n_points = 200,
> ##D   min_prob_threshold = 0.3,
> ##D   max_prob_threshold = 0.7
> ##D )
> ##D 
> ##D # Sample with specific CRS (UTM Zone 18N)
> ##D utm_samples <- sample_points_from_system_de(
> ##D   system_DE,
> ##D   n_points = 300,
> ##D   crs = 32618  # EPSG code for UTM Zone 18N
> ##D )
> ##D 
> ##D # Uniform sampling (ignore probability values)
> ##D uniform_samples <- sample_points_from_system_de(
> ##D   system_DE,
> ##D   n_points = 500,
> ##D   uniform = TRUE  # All eligible cells have equal probability
> ##D )
> ##D 
> ##D # Plot sampled points
> ##D library(ggplot2)
> ##D ggplot() +
> ##D   geom_sf(data = sampled_points, aes(color = probability), alpha = 0.5) +
> ##D   scale_color_viridis_c(name = "Cumulative\nProbability") +
> ##D   theme_minimal()
> ##D 
> ##D # If fish_id and time data exist in future versions:
> ##D # multi_samples <- sample_points_from_system_de(
> ##D #   system_DE,
> ##D #   n_points = 50,
> ##D #   fish_select = c(1, 2, 3),
> ##D #   time_select = c("2025-07-15", "2025-07-16"),
> ##D #   by_group = TRUE
> ##D # )
> ##D 
> ##D # Use position_points as a template for fish-time combinations
> ##D # First get position points from positioning results
> ##D position_points <- sample_points_from_probabilities(
> ##D   positioning_results,
> ##D   n_points = 100,
> ##D   fish_select = c(1, 2),
> ##D   time_select = c("2025-07-15", "2025-07-16")
> ##D )
> ##D 
> ##D # Then sample from system_de using same fish-time combinations
> ##D matched_de_samples <- sample_points_from_system_de(
> ##D   system_DE,
> ##D   n_points = 100,  # Same number per group as position_points
> ##D   position_points = position_points  # Use as template
> ##D )
> ## End(Not run)
> 
> 
> 
> 
