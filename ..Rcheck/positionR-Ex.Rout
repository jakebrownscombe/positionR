> ### * calculate_detection_system
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: calculate_detection_system
> ### Title: Calculate detection system probabilities and create
> ###   visualization
> ### Aliases: calculate_detection_system
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # Generate receiver stations and calculate distances
> ##D stations <- generate_random_points(depth_raster, n_points = 6, seed = 123)
> ##D distances <- calculate_station_distances(depth_raster, stations, max_distance = 500)
> ##D 
> ##D # Create detection efficiency model
> ##D de_model <- create_logistic_curve_depth(
> ##D   min_depth = 2, max_depth = 30,
> ##D   d50_min_depth = 50, d95_min_depth = 20,
> ##D   d50_max_depth = 150, d95_max_depth = 60,
> ##D   plot = FALSE
> ##D )
> ##D 
> ##D # Calculate system detection probabilities
> ##D detection_system <- calculate_detection_system(
> ##D   distance_frame = distances,
> ##D   receiver_frame = stations,
> ##D   model = de_model$log_model,
> ##D   output_type = "both"
> ##D )
> ##D 
> ##D # Extract results
> ##D detection_data <- detection_system$data
> ##D positioning_plot <- detection_system$plots$prob_3_plus
> ##D 
> ##D # Calculate only positioning probabilities without plots
> ##D positioning_only <- calculate_detection_system(
> ##D   distance_frame = distances,
> ##D   receiver_frame = stations,
> ##D   model = de_model$log_model,
> ##D   output_type = "3_plus",
> ##D   plots = FALSE
> ##D )
> ## End(Not run)
> 
> ## Not run: 
> ##D # With character station IDs and deployment filtering
> ##D target_date <- as.Date("2023-07-15")
> ##D 
> ##D system_DE <- calculate_detection_system(
> ##D   distance_frame = station_distances,  # From calculate_station_distances
> ##D   receiver_frame = stoney_rx_deploy,   # With deployment information
> ##D   model = logistic_DE$log_model,
> ##D   target_date = target_date,
> ##D   output_type = "both",
> ##D   station_col = "station_id",
> ##D   deploy_col = "deploy_datetime_UTC",
> ##D   recover_col = "recover_datetime_UTC"
> ##D )
> ##D 
> ##D # Check which stations were active
> ##D print(system_DE$active_stations)
> ##D print(paste("Active stations:", system_DE$n_active_stations))
> ##D 
> ##D # Use all stations (no date filtering)
> ##D system_DE_all <- calculate_detection_system(
> ##D   distance_frame = station_distances,
> ##D   receiver_frame = stoney_rx_deploy,
> ##D   model = logistic_DE$log_model,
> ##D   target_date = NULL,  # No filtering
> ##D   output_type = "cumulative"
> ##D )
> ## End(Not run)
> 
> 
