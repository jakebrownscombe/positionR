> nameEx("print_detection_summary")
> ### * print_detection_summary
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: print_detection_summary
> ### Title: Print detection summary report in readable format
> ### Aliases: print_detection_summary
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # Calculate and print detection summaries
> ##D detection_stats <- calculate_detection_summaries(fish_simulation)
> ##D print_detection_summary(detection_stats)
