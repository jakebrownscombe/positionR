> ### * create_logistic_curve_depth
> 
> flush(stderr()); flush(stdout())
> 
> ### Name: create_logistic_curve_depth
> ### Title: generate detection range models Create logistic curve for
> ###   detection efficiency with depth extrapolation
> ### Aliases: create_logistic_curve_depth
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # Create a basic detection efficiency model
> ##D de_model <- create_logistic_curve_depth(
> ##D   min_depth = 2,
> ##D   max_depth = 30,
> ##D   d50_min_depth = 50,
> ##D   d95_min_depth = 20,
> ##D   d50_max_depth = 150,
> ##D   d95_max_depth = 60
> ##D )
> ##D 
> ##D # Use the model to predict detection efficiency
> ##D efficiency <- de_model$func(dist_m = 100, depth_m = 15)
> ##D 
> ##D # Generate custom predictions
> ##D custom_grid <- de_model$predict_grid(
> ##D   dist_range = seq(0, 200, by = 10),
> ##D   depth_range = seq(5, 25, by = 2)
> ##D )
> ##D 
> ##D # Create model without plots
> ##D de_model_quiet <- create_logistic_curve_depth(
> ##D   min_depth = 2, max_depth = 30,
> ##D   d50_min_depth = 50, d95_min_depth = 20,
> ##D   d50_max_depth = 150, d95_max_depth = 60,
> ##D   plot = FALSE
> ##D )
> ## End(Not run)
> 
> 
> 
> 
