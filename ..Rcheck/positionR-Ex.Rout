> ### Name: plot_fish_positions
> ### Title: Plot fish position estimates from acoustic telemetry
> ### Aliases: plot_fish_positions
> 
> ### ** Examples
> 
> ## Not run: 
> ##D # Calculate positions
> ##D results <- calculate_fish_positions(station_detections, distances, stations)
> ##D 
> ##D # Create all plots for all time periods (default)
> ##D plot_fish_positions(results, depth_raster_df = depth_data)
> ##D 
> ##D # Create only integrated probability plot for all time
> ##D plot_fish_positions(results, plot_type = "integrated")
> ##D 
> ##D # Select specific time using numeric value
> ##D plot_fish_positions(results, time_select = 3600)
> ##D 
> ##D # Select time using date string
> ##D plot_fish_positions(results, time_select = "2024-07-01")
> ##D 
> ##D # Select time using datetime string
> ##D plot_fish_positions(results, time_select = "2024-07-01 15:00")
> ##D 
> ##D # Select time using POSIXct object
> ##D plot_fish_positions(results, time_select = as.POSIXct("2024-07-01 15:00:00"))
> ##D 
> ##D # Customize actual track point size
> ##D plot_fish_positions(results, actual_track_size = 2.5)
> ##D 
> ##D # Get individual plots as list
> ##D plot_fish_positions(results, return_list = TRUE)
> ##D plots$detection
> ##D plots$integrated
> ## End(Not run)
> 
> 
> 
