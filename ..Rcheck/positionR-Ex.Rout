> ##D   station_distances = distances,
> ##D   n_paths = 5,
> ##D   n_steps = 100
> ##D )
> ##D 
> ##D # Calculate detection summaries
> ##D detection_stats <- calculate_detection_summaries(fish_sim)
> ##D 
> ##D # Access overall performance
> ##D overall_rate <- detection_stats$overall$detection_percentage
> ##D 
> ##D # Access per-path performance
> ##D path_performance <- detection_stats$by_path
> ##D 
> ##D # Access per-station performance
> ##D station_performance <- detection_stats$by_station
> ## End(Not run)
